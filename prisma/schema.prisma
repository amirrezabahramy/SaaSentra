// SaaSentra schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  TENANT
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  GRACE_PERIOD
  DISABLED
  CANCELED
  DISABLED_AT_PERIOD_END
  ARCHIVED
}

enum PlanType {
  SUBSCRIPTION
  SERIAL_KEY
}

enum Currency {
  USD
  IRR
}

enum PaymentProvider {
  STRIPE
  ZIBAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ServiceDeployStatus {
  HEALTHY
  DEGRADED
  OFFLINE
}

enum ServicePaymentDeliveryMode {
  CALLBACK
  EMAIL
  CALLBACK_AND_EMAIL
}

enum CheckoutStatus {
  PENDING
  SUCCEEDED
  CANCELED
  EXPIRED
}

enum PaymentDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  NOT_CONFIGURED
}

enum DunningNoticeStatus {
  PENDING
  SENDING
  SENT
  FAILED
  NOT_CONFIGURED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String?
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?
  role          Role
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]
  sessions      Session[]
  accounts      Account[]

  @@index([email])
  @@index([tenantId])
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  billingEmail     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  users            User[]
  subscription     Subscription?
  invoices         Invoice[]
  payments         Payment[]
  serviceAssignments TenantService[]
  auditLogs        AuditLog[]
  serviceActions   ServiceAction[]
  paymentCheckouts PaymentCheckout[]
  dunningNotices   DunningNotice[]

  @@index([slug])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Plan {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  type             PlanType          @default(SUBSCRIPTION)
  isPermanent      Boolean           @default(false)
  priceMinor       Int               @default(0)
  currency         Currency          @default(USD)
  interval         String            @default("month")
  trialDays        Int               @default(0)
  provider         PaymentProvider   @default(STRIPE)
  providerPriceId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  subscriptions    Subscription[]
  paymentCheckouts PaymentCheckout[]

  @@index([slug])
}

model Subscription {
  id                      String             @id @default(uuid())
  tenantId                String             @unique
  planId                  String
  status                  SubscriptionStatus @default(TRIALING)
  currentPeriodStart      DateTime           @default(now())
  currentPeriodEnd        DateTime
  serialKey               String?            @unique
  submittedSerialKey      String?
  cancelAt                DateTime?
  canceledAt              DateTime?
  cancellationRefundMinor Int?
  graceEndsAt             DateTime?
  disabledAt              DateTime?
  providerCustomerId      String?
  providerSubscriptionId  String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deletedAt               DateTime?
  tenant                  Tenant             @relation(fields: [tenantId], references: [id])
  plan                    Plan               @relation(fields: [planId], references: [id])
  invoices                Invoice[]
  paymentCheckouts        PaymentCheckout[]
  dunningNotices          DunningNotice[]

  @@index([tenantId, createdAt])
  @@index([status])
}

model DunningNotice {
  id             String              @id @default(uuid())
  subscriptionId String
  tenantId       String
  noticeType     String
  periodKey      String
  toEmail        String?
  status         DunningNoticeStatus @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, noticeType, periodKey])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  number         String        @unique
  amountMinor    Int
  currency       Currency      @default(USD)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@index([tenantId, createdAt])
}

model Payment {
  id                String          @id @default(uuid())
  tenantId          String
  invoiceId         String?
  amountMinor       Int
  currency          Currency        @default(USD)
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(STRIPE)
  providerPaymentId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, createdAt])
}

model Service {
  id                     String                     @id @default(uuid())
  name                   String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  deletedAt              DateTime?
  flagDefinitions        ServiceFlag[]
  tenantAssignments      TenantService[]
  actions                ServiceAction[]
  paymentCheckouts       PaymentCheckout[]
}

model PaymentCheckout {
  id                String           @id @default(uuid())
  tenantId          String
  serviceId         String
  subscriptionId    String?
  planId            String
  provider          PaymentProvider
  providerPaymentId String?          @unique
  status            CheckoutStatus   @default(PENDING)
  returnUrl         String?
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  service           Service          @relation(fields: [serviceId], references: [id])
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id])
  plan              Plan             @relation(fields: [planId], references: [id])
  delivery          PaymentDelivery?

  @@index([tenantId, createdAt])
  @@index([serviceId, status])
}

model PaymentDelivery {
  id          String                @id @default(uuid())
  checkoutId  String                @unique
  status      PaymentDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  checkout    PaymentCheckout       @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String          @id @default(uuid())
  provider  PaymentProvider
  eventId   String
  createdAt DateTime        @default(now())

  @@unique([provider, eventId])
}

model ServiceAction {
  id        String    @id @default(uuid())
  tenantId  String
  serviceId String
  actorId   String?
  action    String
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  service   Service   @relation(fields: [serviceId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model TenantService {
  id                     String                     @id @default(uuid())
  tenantId               String
  serviceId              String
  serviceApiKeyHash      String?
  serviceApiKeyLastFour  String?
  serviceApiKeyCreatedAt DateTime?
  serviceApiKeyRevokedAt DateTime?
  deployStatus           ServiceDeployStatus        @default(HEALTHY)
  paymentCallbackUrl     String?
  paymentCallbackSecret  String?
  paymentDeliveryMode    ServicePaymentDeliveryMode @default(CALLBACK)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  tenant                 Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service                Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  flags                  TenantServiceFlag[]

  @@unique([tenantId, serviceId])
  @@index([tenantId, createdAt])
  @@index([serviceId, createdAt])
}

model ServiceFlag {
  id          String              @id @default(uuid())
  serviceId   String
  key         String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignments TenantServiceFlag[]

  @@unique([serviceId, key])
  @@index([serviceId, createdAt])
}

model TenantServiceFlag {
  id            String        @id @default(uuid())
  tenantServiceId String
  serviceFlagId String
  enabled       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenantService TenantService @relation(fields: [tenantServiceId], references: [id], onDelete: Cascade)
  serviceFlag   ServiceFlag   @relation(fields: [serviceFlagId], references: [id], onDelete: Cascade)

  @@unique([tenantServiceId, serviceFlagId])
  @@index([tenantServiceId, createdAt])
  @@index([serviceFlagId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
}
