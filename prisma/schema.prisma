// SaaS Dashboard starter schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  GRACE_PERIOD
  DISABLED
  CANCELED
  DISABLED_AT_PERIOD_END
  ARCHIVED
}

enum PlanType {
  SUBSCRIPTION
  SERIAL_KEY
}

enum Currency {
  USD
  IRR
}

enum PaymentProvider {
  STRIPE
  ZIBAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ServiceControlType {
  ENTITLEMENT
  TOKEN
  WEBHOOK
  INFRA
}

enum ServiceDeployStatus {
  HEALTHY
  DEGRADED
  OFFLINE
}

enum CheckoutStatus {
  PENDING
  SUCCEEDED
  CANCELED
  EXPIRED
}

enum PaymentDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  NOT_CONFIGURED
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String?
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  memberships   Membership[]
  auditLogs     AuditLog[]
  sessions      Session[]
  accounts      Account[]

  @@index([email])
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  memberships      Membership[]
  subscription     Subscription?
  invoices         Invoice[]
  payments         Payment[]
  services         Service[]
  flags            TenantFlag[]
  auditLogs        AuditLog[]
  serviceActions   ServiceAction[]
  paymentCheckouts PaymentCheckout[]

  @@index([slug])
}

model Membership {
  id        String    @id @default(uuid())
  userId    String
  tenantId  String
  role      Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@index([tenantId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Plan {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  type             PlanType          @default(SUBSCRIPTION)
  isPermanent      Boolean           @default(false)
  priceMinor       Int               @default(0)
  currency         Currency          @default(USD)
  interval         String            @default("month")
  trialDays        Int               @default(0)
  provider         PaymentProvider   @default(STRIPE)
  providerPriceId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  subscriptions    Subscription[]
  paymentCheckouts PaymentCheckout[]

  @@index([slug])
}

model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  serialKey              String?            @unique
  cancelAt               DateTime?
  graceEndsAt            DateTime?
  disabledAt             DateTime?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  plan                   Plan               @relation(fields: [planId], references: [id])
  invoices               Invoice[]
  paymentCheckouts       PaymentCheckout[]

  @@index([tenantId, createdAt])
  @@index([status])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  subscriptionId String?
  number         String        @unique
  amountMinor    Int
  currency       Currency      @default(USD)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]

  @@index([tenantId, createdAt])
}

model Payment {
  id                String          @id @default(uuid())
  tenantId          String
  invoiceId         String?
  amountMinor       Int
  currency          Currency        @default(USD)
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(STRIPE)
  providerPaymentId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  invoice           Invoice?        @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, createdAt])
}

model Service {
  id                    String              @id @default(uuid())
  tenantId              String
  name                  String
  controlType           ServiceControlType  @default(ENTITLEMENT)
  endpointUrl           String?
  deployStatus          ServiceDeployStatus @default(HEALTHY)
  paymentCallbackUrl    String?
  paymentCallbackSecret String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  actions               ServiceAction[]
  paymentCheckouts      PaymentCheckout[]

  @@index([tenantId, createdAt])
}

model PaymentCheckout {
  id                String          @id @default(uuid())
  tenantId          String
  serviceId         String
  subscriptionId    String?
  planId            String
  provider          PaymentProvider
  providerPaymentId String?         @unique
  status            CheckoutStatus  @default(PENDING)
  returnUrl         String?
  expiresAt         DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  service           Service         @relation(fields: [serviceId], references: [id])
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])
  plan              Plan            @relation(fields: [planId], references: [id])
  delivery          PaymentDelivery?

  @@index([tenantId, createdAt])
  @@index([serviceId, status])
}

model PaymentDelivery {
  id          String                 @id @default(uuid())
  checkoutId  String                 @unique
  status      PaymentDeliveryStatus  @default(PENDING)
  attempts    Int                    @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  checkout    PaymentCheckout        @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
}

model ServiceAction {
  id        String    @id @default(uuid())
  tenantId  String
  serviceId String
  actorId   String?
  action    String
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  service   Service   @relation(fields: [serviceId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model FeatureFlag {
  id          String       @id @default(uuid())
  key         String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  tenantFlags TenantFlag[]

  @@index([key])
}

model TenantFlag {
  id        String      @id @default(uuid())
  tenantId  String
  flagId    String
  enabled   Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  flag      FeatureFlag @relation(fields: [flagId], references: [id])

  @@unique([tenantId, flagId])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
}
