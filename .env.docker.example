# PostgreSQL container settings
POSTGRES_USER=saas
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=saas

# Host port for the application
APP_PORT=3000

# The app uses the Compose service name "db", not localhost.
DATABASE_URL=postgresql://saas:change-this-database-password@db:5432/saas?schema=public
SHADOW_DATABASE_URL=postgresql://saas:change-this-database-password@db:5432/saas_shadow?schema=public

SERVER_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
ENTITLEMENT_SHARED_SECRET=replace-with-a-long-shared-service-secret

# Provider configuration. Replace test values before production deployment.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
ZIBAL_MERCHANT=zibal

# Optional email delivery configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=billing@example.com

# Enable this only for the single app instance that owns dunning scheduling.
DUNNING_SCHEDULER_ENABLED=true
